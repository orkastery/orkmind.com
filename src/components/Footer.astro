---
import {localeFor,localize,ui} from '../data/i18n';
import {externos} from '../data/externos';
const locale=localeFor(Astro.url.pathname),text=ui(locale);
---
<footer class="site-footer"><div class="footer-inner">
 <div><p class="footer-brand">OrkMind</p><p>{text.openSource} · {text.license}</p><a href="mailto:maestro@orkastery.com">maestro@orkastery.com</a></div>
 <nav aria-label={text.docs}><a href={localize('/docs/',locale)}>{text.docs}</a><a href={localize('/docs/arquitetura/',locale)}>{text.concepts}</a><a href={localize('/docs/roadmap/',locale)}>{text.roadmap}</a></nav>
 <nav aria-label={text.openSource}><a href={externos.orkastery.url}>Orkastery · GitHub</a><a href={externos.orkmind.url}>OrkMind · GitHub</a><a href={'https://orkastery.com'+localize('/',locale)}>Orkastery</a></nav>
 </div></footer>
<style>
.site-footer{padding:3rem 1.5rem;border-top:1px solid var(--linha-forte);background:var(--palco,var(--fundo-2));color:var(--tinta-2,var(--texto-2));font-size:.92rem;}
.footer-inner{max-width:1160px;margin:auto;display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:2rem;}
.footer-brand{font:500 1.7rem var(--f-display,var(--fonte-display));color:var(--tinta,var(--texto));margin-bottom:1rem;}
.footer-inner nav{display:grid;align-content:start;gap:.8rem;}
a{color:inherit;text-underline-offset:.3em;}a:focus-visible{outline:2px solid currentColor;outline-offset:4px;}
@media(max-width:760px){.footer-inner{grid-template-columns:1fr;}}
</style>
