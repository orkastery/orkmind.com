---
// Faixa logo abaixo do hero: por onde a memória chega aos agentes (os hosts com integração).
const {t}=Astro.props;
---
<section class="hosts" aria-label={t.hosts.label}>
 <div class="container hosts-linha">
  <span class="hosts-rotulo">{t.hosts.label}</span>
  <ul class="hosts-lista">{t.hosts.list.map((n:string)=><li>{n}</li>)}</ul>
 </div>
</section>
<style>
.hosts{padding:var(--e-2) 0 var(--e-7)}
.hosts-linha{display:flex;flex-wrap:wrap;align-items:center;gap:var(--e-3) var(--e-6)}
.hosts-rotulo{font:var(--tipo-apoio);color:var(--texto-3)}
.hosts-lista{display:flex;flex-wrap:wrap;gap:var(--e-2) var(--e-6);margin:0;padding:0;list-style:none;font:var(--peso-destaque) 15px/1 var(--f-mono);color:var(--texto-2)}
</style>
