---
import {localeFor,ui} from '../data/i18n';
const text=ui(localeFor(Astro.url.pathname));
---
<section class="site-contact" id="contato" aria-labelledby="contato-titulo"><div class="contact-inner">
 <div><h2 id="contato-titulo">{text.contact}</h2><p>{text.contactText}</p><a href="mailto:maestro@orkastery.com">maestro@orkastery.com</a></div>
 <form data-contact-form data-subject={text.contact} action="mailto:maestro@orkastery.com" method="get">
 <label for="contato-nome">{text.name}</label><input id="contato-nome" name="name" autocomplete="name" required/>
 <label for="contato-email">{text.email}</label><input id="contato-email" name="email" type="email" autocomplete="email" required/>
 <label for="contato-mensagem">{text.message}</label><textarea id="contato-mensagem" name="body" rows="5" required></textarea>
 <button type="submit">{text.send}</button><p class="form-help">{text.mailHelp}</p>
 </form>
 </div></section>
<script>
 document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form=>{
  form.addEventListener('submit',event=>{
   event.preventDefault();if(!form.reportValidity())return;
   const data=new FormData(form);
   const query=new URLSearchParams({subject:form.dataset.subject||'',body:`${data.get('name')} <${data.get('email')}>\n\n${data.get('body')}`});
   window.location.href='mailto:maestro@orkastery.com?'+query.toString();
  });
 });
</script>
<style>
.site-contact{padding:4rem 1.5rem;background:var(--palco,var(--fundo-2));border-top:1px solid var(--linha-forte);}
.contact-inner{max-width:1160px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:3rem;}
h2{font:500 clamp(1.8rem,3vw,2.8rem)/1.2 var(--f-display,var(--fonte-display));}
p{line-height:1.65;margin:1rem 0;color:var(--tinta-2,var(--texto-2));}
a{color:var(--latao,var(--verde));text-underline-offset:.3em;}
form{display:grid;gap:.55rem;min-width:0;}
label{margin-top:.5rem;font-size:.95rem;}
input,textarea{width:100%;padding:.8rem 1rem;border:1px solid var(--linha-forte);border-radius:8px;background:var(--painel,var(--fundo-3));color:var(--tinta,var(--texto));font:inherit;box-sizing:border-box;}
button{margin-top:.75rem;justify-self:start;background:var(--latao,var(--verde));color:var(--sobre-latao,var(--fundo));border:0;border-radius:999px;padding:.9rem 1.4rem;font:600 1rem var(--f-texto,var(--fonte-texto));cursor:pointer;}
.form-help{font-size:.85rem;margin:.4rem 0;}
input:focus-visible,textarea:focus-visible,button:focus-visible{outline:2px solid var(--latao,var(--verde));outline-offset:4px;}
@media(max-width:760px){.contact-inner{grid-template-columns:1fr;gap:2rem;}}
</style>
