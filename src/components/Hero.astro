---
import Icone from "./Icone.astro";
---

<section class="hero" data-hero aria-labelledby="hero-titulo">
  <canvas class="hero-canvas" data-campo-memoria aria-hidden="true"></canvas>
  <div class="hero-veu" aria-hidden="true"></div>

  <div class="container hero-conteudo">
    <p class="hero-categoria">Company Brain para sistemas agênticos</p>
    <h1 class="titulo-display hero-titulo" id="hero-titulo">
      A empresa sabe.<br />O sistema conecta.
    </h1>
    <p class="prosa hero-sub">
      O OrkMind conecta conhecimento, decisões e execução: memória tipada,
      documentos nativos, proveniência, acesso governado e contexto que chega aos agentes.
    </p>
    <div class="hero-acoes">
      <button class="chip-pip" type="button" data-copiar-pip>
        <code>pip install orkmind</code>
        <span class="chip-icones" aria-hidden="true">
          <Icone nome="copy" tamanho={17} classe="icone-copiar" />
          <Icone nome="check" tamanho={17} classe="icone-copiado" />
        </span>
        <span class="visually-hidden">Copiar comando de instalação</span>
      </button>
      <span class="chip-aviso" data-aviso-copia aria-live="polite"></span>
      <a class="botao botao-secundario" href="#produto">Explorar o produto</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    align-items: center;
    overflow: clip;
    background:
      radial-gradient(
        900px 520px at 78% 42%,
        rgba(52, 211, 153, 0.07),
        transparent 65%
      ),
      radial-gradient(
        1200px 700px at 20% 110%,
        rgba(38, 57, 77, 0.35),
        transparent 70%
      ),
      var(--fundo);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-veu {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 9, 14, 0.55) 0%,
      transparent 30%,
      transparent 72%,
      var(--fundo) 100%
    );
  }

  .hero-conteudo {
    position: relative;
    padding-block: 7rem 5rem;
    max-width: none;
  }

  .hero-categoria {
    font-family: var(--fonte-mono);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--verde);
    margin-bottom: 1.4rem;
    animation: hero-subir 0.9s var(--ease-suave) both;
  }

  .hero-titulo {
    font-size: clamp(2.7rem, 6.4vw, 4.7rem);
    max-width: 17ch;
    animation: hero-subir 0.9s var(--ease-suave) 0.08s both;
  }

  .hero-sub {
    margin-top: 1.5rem;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    max-width: 46ch;
    animation: hero-subir 0.9s var(--ease-suave) 0.16s both;
  }

  .hero-acoes {
    margin-top: 2.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    animation: hero-subir 0.9s var(--ease-suave) 0.24s both;
  }

  .chip-pip {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--fundo-3);
    border: 1px solid var(--verde-linha);
    border-radius: var(--raio-pill);
    padding: 0.78rem 1.35rem;
    color: var(--texto);
    transition:
      border-color var(--dur-micro) var(--ease-suave),
      background var(--dur-micro) var(--ease-suave),
      transform var(--dur-micro) var(--ease-suave);
  }

  .chip-pip:hover {
    background: var(--verde-tinta);
    border-color: var(--verde);
  }

  .chip-pip:active {
    transform: translateY(1px) scale(0.985);
  }

  .chip-pip code {
    font-size: 0.98rem;
    color: var(--verde-forte);
  }

  .chip-icones {
    display: inline-flex;
    color: var(--texto-2);
  }

  .chip-icones :global(.icone-copiado) {
    display: none;
    color: var(--verde);
  }

  .chip-pip[data-copiado] :global(.icone-copiar) {
    display: none;
  }

  .chip-pip[data-copiado] :global(.icone-copiado) {
    display: inline-flex;
  }

  .chip-aviso {
    font-size: 0.85rem;
    color: var(--verde);
  }

  @keyframes hero-subir {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero-conteudo {
      padding-block: 6.5rem 4rem;
    }
  }
</style>

<script>
  import "../scripts/memoria-field";

  const chip = document.querySelector<HTMLButtonElement>("[data-copiar-pip]");
  const aviso = document.querySelector<HTMLElement>("[data-aviso-copia]");
  if (chip) {
    chip.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("pip install orkmind");
        chip.setAttribute("data-copiado", "");
        if (aviso) aviso.textContent = "Comando copiado";
        window.setTimeout(() => {
          chip.removeAttribute("data-copiado");
          if (aviso) aviso.textContent = "";
        }, 2200);
      } catch {
        if (aviso) aviso.textContent = "Copie: pip install orkmind";
      }
    });
  }
</script>
