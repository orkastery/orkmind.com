---
import { localize, ui } from '../data/i18n';
const {articles,locale,current}=Astro.props,text=ui(locale);
const groups=[...new Set(articles.map(a=>a.group))];
---
<nav class="docs-navigation" aria-label={text.contents}>
 <details open data-docs-nav><summary>{text.contents}</summary>
 {groups.map(group=><div class="nav-group"><p>{text[group]}</p><ul>{articles.filter(a=>a.group===group).map(a=><li><a href={localize('/docs/'+a.slug+'/',locale)} aria-current={a.slug===current?'page':undefined}>{a.translations[locale].title}</a></li>)}</ul></div>)}
 </details>
</nav>
<script>
 const menu=document.querySelector<HTMLDetailsElement>('[data-docs-nav]');
 if(menu && matchMedia('(max-width: 900px)').matches) menu.open=false;
</script>
