---
const camadas = [
  {
    rotulo: "runtimes",
    titulo: "Quem consome",
    itens: ["Claude Code", "Codex", "Hermes", "OpenClaw", "OrkMind Web"],
    desc: "Quatro hosts e o workspace usam contratos oficiais; a identidade vem do transporte autenticado.",
  },
  {
    rotulo: "integrações",
    titulo: "Como chega",
    itens: [
      "Servidor MCP com 7 tools",
      "Provider de memória",
      "API idempotente",
      "Company Brain B1",
    ],
    desc: "Adaptadores permanecem finos: regras de identidade, ACL, captura e consulta ficam nos núcleos.",
  },
  {
    rotulo: "semântica",
    titulo: "Onde decide",
    itens: [
      "Casamento exato de tags",
      "Detectores de contexto",
      "Orçamento de tokens",
      "Camadas E1, E2, E3",
      "Rerank RRF opcional",
      "prod → proj → init",
    ],
    desc: "A SemanticLayer resolve o que entra no contexto: exato por padrão, semântico como aditivo.",
  },
  {
    rotulo: "governança",
    titulo: "O que protege",
    itens: [
      "Proteção de entradas",
      "ACL por tags de acesso",
      "Versionamento append-only",
      "Ordenação constitucional",
      "CAS e referências fixadas",
    ],
    desc: "A GovernedStore mora acima do adaptador: nenhum backend consegue afrouxar as garantias.",
  },
  {
    rotulo: "persistência",
    titulo: "Onde vive",
    itens: ["PostgreSQL + pgvector", "memory (testes)", "qdrant (opcional)", "receipts + outbox"],
    desc: "Persistência real inclui histórico, readback e reconciliação; fixture e fallback não fingem produção.",
  },
];
---

<section class="secao arquitetura" id="arquitetura" aria-labelledby="arq-titulo">
  <div class="container">
    <div class="arq-cabeca">
      <h2 class="titulo-display" id="arq-titulo">
        Governança acima do adaptador
      </h2>
      <p class="prosa">
        Da chamada do runtime ao disco, cada camada tem um dever só. É por isso
        que as garantias valem em qualquer backend.
      </p>
    </div>

    <div class="camadas" data-camadas>
      {camadas.map((c, i) => (
        <div class="camada" style={`--i:${i}`}>
          <div class="camada-meta">
            <code>{c.rotulo}</code>
            <h3>{c.titulo}</h3>
          </div>
          <div class="camada-corpo">
            <ul role="list">
              {c.itens.map((item) => <li>{item}</li>)}
            </ul>
            <p>{c.desc}</p>
          </div>
          {i < camadas.length - 1 && (
            <span class="camada-seta" aria-hidden="true"></span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .arquitetura {
    background: var(--fundo-2);
    border-block: 1px solid var(--linha);
  }

  .arq-cabeca {
    max-width: 60ch;
    display: grid;
    gap: 1.1rem;
    margin-bottom: 3.4rem;
  }

  .arq-cabeca h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }

  .camadas {
    display: grid;
    gap: 1.9rem;
  }

  .camada {
    position: relative;
    display: grid;
    gap: 1rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio-painel);
    background: var(--fundo-3);
    padding: 1.5rem 1.7rem;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s var(--ease-suave),
      transform 0.7s var(--ease-suave),
      border-color var(--dur-micro) var(--ease-suave);
    transition-delay: calc(var(--i) * 110ms), calc(var(--i) * 110ms), 0s;
  }

  [data-visivel] .camada {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .camada {
      opacity: 1;
      transform: none;
    }
  }

  .camada:hover {
    border-color: var(--verde-linha);
  }

  .camada-meta {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .camada-meta code {
    color: var(--verde);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .camada-meta h3 {
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .camada-corpo {
    display: grid;
    gap: 0.9rem;
  }

  .camada-corpo ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .camada-corpo li {
    font-family: var(--fonte-mono);
    font-size: 0.8rem;
    color: var(--texto-2);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pill);
    padding: 0.42rem 0.8rem;
    transition:
      color var(--dur-micro) var(--ease-suave),
      border-color var(--dur-micro) var(--ease-suave);
  }

  .camada:hover .camada-corpo li {
    color: var(--texto);
  }

  .camada-corpo p {
    color: var(--texto-2);
    font-size: 0.92rem;
    max-width: 62ch;
  }

  .camada-seta {
    position: absolute;
    left: 50%;
    bottom: -1.55rem;
    width: 1px;
    height: 1.2rem;
    background: linear-gradient(180deg, var(--verde-linha), transparent);
  }

  .camada-seta::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    border: 4px solid transparent;
    border-top-color: var(--verde-linha);
  }

  @media (min-width: 860px) {
    .camada {
      grid-template-columns: 200px 1fr;
      gap: 2.2rem;
    }
  }
</style>

<script>
  const grade = document.querySelector<HTMLElement>("[data-camadas]");
  if (grade) {
    const io = new IntersectionObserver(
      ([entrada]) => {
        if (entrada && entrada.isIntersecting) {
          grade.setAttribute("data-visivel", "");
          io.disconnect();
        }
      },
      { threshold: 0.08 },
    );
    io.observe(grade);
  }
</script>
