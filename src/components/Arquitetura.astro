---
import {localeFor, localize} from '../data/i18n';
const locale=localeFor(Astro.url.pathname);
const translations={
  "t0": {
    "pt": "Quem consome",
    "en": "Who consumes it"
  },
  "t1": {
    "pt": "Os hosts usam contratos oficiais; a identidade vem do transporte autenticado.",
    "en": "Hosts use official contracts; identity comes from the authenticated transport."
  },
  "t2": {
    "pt": "integrações",
    "en": "integrations"
  },
  "t3": {
    "pt": "Como chega",
    "en": "How it arrives"
  },
  "t4": {
    "pt": "Servidor MCP",
    "en": "MCP server"
  },
  "t5": {
    "pt": "Provider de memória",
    "en": "Memory provider"
  },
  "t6": {
    "pt": "API idempotente",
    "en": "Idempotent API"
  },
  "t7": {
    "pt": "Company Brain B1",
    "en": "Company Brain B1"
  },
  "t8": {
    "pt": "Adaptadores permanecem finos: regras de identidade, ACL, captura e consulta ficam nos núcleos.",
    "en": "Adapters stay thin: identity, ACL, capture and query rules live in the cores."
  },
  "t9": {
    "pt": "semântica",
    "en": "semantics"
  },
  "t10": {
    "pt": "Onde decide",
    "en": "Where context is selected"
  },
  "t11": {
    "pt": "Casamento exato de tags",
    "en": "Exact tag matching"
  },
  "t12": {
    "pt": "Detectores de contexto",
    "en": "Context detectors"
  },
  "t13": {
    "pt": "Orçamento de tokens",
    "en": "Token budget"
  },
  "t14": {
    "pt": "Camadas E1, E2, E3",
    "en": "E1, E2, E3 layers"
  },
  "t15": {
    "pt": "Rerank RRF opcional",
    "en": "Optional RRF reranking"
  },
  "t16": {
    "pt": "A `SemanticLayer` resolve o que entra no contexto: exato por padrão, semântico como aditivo.",
    "en": "`SemanticLayer` selects context: exact matching by default, semantic retrieval as an addition."
  },
  "t17": {
    "pt": "governança",
    "en": "governance"
  },
  "t18": {
    "pt": "O que protege",
    "en": "What protects it"
  },
  "t19": {
    "pt": "Proteção de entradas",
    "en": "Entry protection"
  },
  "t20": {
    "pt": "ACL por tags de acesso",
    "en": "ACL through access tags"
  },
  "t21": {
    "pt": "Versionamento append-only",
    "en": "Append-only versioning"
  },
  "t22": {
    "pt": "Ordenação constitucional",
    "en": "Constitutional ordering"
  },
  "t23": {
    "pt": "CAS e referências fixadas",
    "en": "CAS and pinned references"
  },
  "t24": {
    "pt": "A `GovernedStore` mora acima do adaptador: nenhum backend consegue afrouxar as garantias.",
    "en": "`GovernedStore` sits above the adapter, preserving guarantees across backends."
  },
  "t25": {
    "pt": "persistência",
    "en": "persistence"
  },
  "t26": {
    "pt": "Onde vive",
    "en": "Where it lives"
  },
  "t27": {
    "pt": "`memory` (testes)",
    "en": "`memory` (tests)"
  },
  "t28": {
    "pt": "`qdrant` (opcional)",
    "en": "`qdrant` (optional)"
  },
  "t29": {
    "pt": "Persistência real inclui histórico, readback e reconciliação; fixture e fallback não fingem produção.",
    "en": "Persistence includes history, readback and reconciliation. Fixtures and fallbacks remain explicit."
  },
  "t30": {
    "pt": "Governança acima do adaptador",
    "en": "Governance above the adapter"
  },
  "t31": {
    "pt": "Da chamada do runtime ao disco, cada camada tem um dever só. É por isso\n        que as garantias valem em qualquer backend.",
    "en": "From the runtime call to disk, each layer has a specific responsibility. Governance remains above storage."
  }
};
const t=(key:keyof typeof translations)=>translations[key][locale];
import TechnicalText from './TechnicalText.astro';
const camadas = [
  {
    rotulo: "runtimes",
    titulo: t("t0"),
    itens: ["Claude Code", "Codex", "Hermes", "OpenClaw"],
    desc: t("t1"),
  },
  {
    rotulo: t("t2"),
    titulo: t("t3"),
    itens: [
      t("t4"),
      t("t5"),
      t("t6"),
      t("t7"),
    ],
    desc: t("t8"),
  },
  {
    rotulo: t("t9"),
    titulo: t("t10"),
    itens: [
      t("t11"),
      t("t12"),
      t("t13"),
      t("t14"),
      t("t15"),
      "`prod` → `proj` → `init`",
    ],
    desc: t("t16"),
  },
  {
    rotulo: t("t17"),
    titulo: t("t18"),
    itens: [
      t("t19"),
      t("t20"),
      t("t21"),
      t("t22"),
      t("t23"),
    ],
    desc: t("t24"),
  },
  {
    rotulo: t("t25"),
    titulo: t("t26"),
    itens: ["PostgreSQL + pgvector", t("t27"), t("t28"), "receipts + outbox"],
    desc: t("t29"),
  },
];
---

<section class="secao arquitetura" id="arquitetura" aria-labelledby="arq-titulo">
  <div class="container">
    <div class="arq-cabeca">
      <h2 class="titulo-display" id="arq-titulo">
        <TechnicalText text={t("t30")}/>
      </h2>
      <p class="prosa">
        <TechnicalText text={t("t31")}/>
      </p>
    </div>

    <div class="camadas" data-camadas>
      {camadas.map((c, i) => (
        <div class="camada" style={`--i:${i}`}>
          <div class="camada-meta">
            <span class="camada-rotulo">{c.rotulo}</span>
            <h3><TechnicalText text={c.titulo}/></h3>
          </div>
          <div class="camada-corpo">
            <ul role="list">
              {c.itens.map((item) => <li><TechnicalText text={item}/></li>)}
            </ul>
            <p><TechnicalText text={c.desc}/></p>
          </div>
          {i < camadas.length - 1 && (
            <span class="camada-seta" aria-hidden="true"></span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .arquitetura {
    background: var(--fundo-2);
    border-block: 1px solid var(--linha);
  }

  .arq-cabeca {
    max-width: 60ch;
    display: grid;
    gap: 1.1rem;
    margin-bottom: 3.4rem;
  }

  .arq-cabeca h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }

  .camadas {
    display: grid;
    gap: 1.9rem;
  }

  .camada {
    position: relative;
    display: grid;
    gap: 1rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio-painel);
    background: var(--fundo-3);
    padding: 1.5rem 1.7rem;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease-suave),
      transform 0.7s var(--ease-suave),
      border-color var(--dur-micro) var(--ease-suave);
    transition-delay: calc(var(--i) * 110ms), calc(var(--i) * 110ms), 0s;
  }

  [data-visivel] .camada {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .camada {
      opacity: 1;
      transform: none;
    }
  }

  .camada:hover {
    border-color: var(--verde-linha);
  }

  .camada-meta {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  /* Rótulo da camada (não é identificador): mesmo desenho do antigo code, sem o chip. */
  .camada-rotulo {
    font-family: var(--fonte-mono);
    color: var(--verde);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .camada-meta h3 {
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .camada-corpo {
    display: grid;
    gap: 0.9rem;
  }

  .camada-corpo ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .camada-corpo li {
    font-family: var(--fonte-mono);
    font-size: 0.8rem;
    color: var(--texto-2);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pill);
    padding: 0.42rem 0.8rem;
    transition:
      color var(--dur-micro) var(--ease-suave),
      border-color var(--dur-micro) var(--ease-suave);
  }

  .camada:hover .camada-corpo li {
    color: var(--texto);
  }

  /* A pílula já é monoespaçada: o código dentro dela (backend, nível do portfólio) mantém a
     semântica e o chip atômico, sem segunda borda nem outro tamanho. */
  .camada-corpo li :global(code) {
    font-size: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
  }

  .camada-corpo p {
    color: var(--texto-2);
    font-size: 0.92rem;
    max-width: 62ch;
  }

  .camada-seta {
    position: absolute;
    left: 50%;
    bottom: -1.55rem;
    width: 1px;
    height: 1.2rem;
    background: linear-gradient(180deg, var(--verde-linha), transparent);
  }

  .camada-seta::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    border: 4px solid transparent;
    border-top-color: var(--verde-linha);
  }

  @media (min-width: 860px) {
    .camada {
      grid-template-columns: 200px 1fr;
      gap: 2.2rem;
    }
  }
</style>

<script>
  const grade = document.querySelector<HTMLElement>("[data-camadas]");
  if (grade) {
    const io = new IntersectionObserver(
      ([entrada]) => {
        if (entrada && entrada.isIntersecting) {
          grade.setAttribute("data-visivel", "");
          io.disconnect();
        }
      },
      { threshold: 0.08 },
    );
    io.observe(grade);
  }
</script>
