---
// Seletor de língua em pílula (Partitura): PT-BR em / e inglês em /en/, mono 12, a língua atual
// em tinta, como o botão de tema do kit. Cada opção leva à mesma página na outra língua; o nome
// acessível começa pelo rótulo visível ("PT, Português"), como pede o WCAG 2.5.3.
import {locales,languageName,languageTag,localeFor,localize,moldura,ui} from '../data/i18n';
const locale=localeFor(Astro.url.pathname),text=ui(locale),m=moldura(locale);
---
<nav class="linguas" aria-label={text.language} data-language-selector>
 {locales.map(l=><a href={localize(Astro.url.pathname,l)} hreflang={languageTag[l]} lang={languageTag[l]} aria-current={l===locale?'page':undefined} title={languageName[l]}><span>{m.languageShort[l]}</span><span class="so-leitor">, {languageName[l]}</span></a>)}
</nav>
<style>
.linguas{display:flex;align-items:center;gap:2px;padding:2px;border:1px solid var(--linha);border-radius:var(--raio-botao);background:var(--superficie);font:var(--peso-destaque) 12px/1 var(--f-mono);letter-spacing:.04em;flex:none}
/* Alvo de toque de 44 px (regra dura 5 do kit). */
.linguas a{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:0 var(--e-2);border-radius:10px;color:var(--texto-3);text-decoration:none}
.linguas a[aria-current]{background:var(--acao);color:var(--sobre-acao)}
.linguas a:not([aria-current]):hover{color:var(--texto)}
</style>
