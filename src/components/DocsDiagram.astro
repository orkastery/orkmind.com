---
import diagrams from '../data/docs-diagrams';
import TechnicalText from './TechnicalText.astro';
import {plainText,technicalSvg} from '../lib/technical-text.mjs';
const {name,locale}=Astro.props,d=diagrams[name]?.[locale];
if(!d) throw Error('Missing diagram translation: '+name+'/'+locale);
const prefix='diagram-'+name;
const height=d.nodes.length*112-28;
---
<figure class="docs-diagram" data-docs-diagram>
 <svg viewBox={`0 0 540 ${height}`} role="img" aria-labelledby={`${prefix}-title ${prefix}-desc`}>
 <title id={prefix+'-title'}>{plainText(d.title)}</title><desc id={prefix+'-desc'}>{plainText(d.description)}</desc>
 <defs><marker id={prefix+'-arrow'} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0 8 4 0 8" fill="currentColor"/></marker></defs>
 {d.nodes.map((node,i)=><g><rect x="12" y={i*112+4} width="516" height="66" rx="10"/><text x="34" y={i*112+44}>{i+1}.</text><text x="75" y={i*112+(node.includes(' · ')?30:44)}><tspan set:html={technicalSvg(node.split(' · ')[0])}/>{node.includes(' · ')&&<tspan x="75" dy="27" class="node-detail" set:html={technicalSvg(node.split(' · ')[1])}/>}</text>{i < d.nodes.length - 1 && <g><path class="connector" d={`M48 ${i*112+72} v32`} marker-end={`url(#${prefix}-arrow)`}/><text class="edge-label" x="75" y={i*112+98} set:html={technicalSvg(d.edges[i])}/></g>}</g>)}
 </svg>
 <figcaption><strong><TechnicalText text={d.title+'.'}/></strong> <TechnicalText text={d.description}/></figcaption>
</figure>
<style>
.docs-diagram{margin:2rem 0;padding:1.25rem;background:var(--doc-panel,var(--painel,var(--fundo-3)));border:1px solid var(--linha-forte);border-radius:12px;}
svg{width:100%;max-width:540px;display:block;margin:auto;color:var(--doc-text,var(--tinta,var(--texto)));}
rect{fill:transparent;stroke:currentColor;stroke-width:1.2;}
text{fill:currentColor;font:24px var(--f-texto,var(--fonte-texto));}
.edge-label{font-size:21px;}
/* Código no SVG: o renderizador marca o trecho como tspan.code, em fonte monoespaçada. */
:global(svg tspan.code){font-family:var(--f-mono,var(--fonte-mono));}
.connector{fill:none;stroke:currentColor;stroke-width:1.5;}
figcaption{font-size:.9rem;line-height:1.65;margin-top:1rem;}
@media(max-width:550px){.docs-diagram{padding:.75rem;}text,.edge-label{font-size:24px;}}
</style>
