---
import { colecoes } from "../data/colecoes";
---

<section class="secao ontologia" id="memoria" aria-labelledby="ontologia-titulo">
  <div class="container">
    <div class="ontologia-cabeca">
      <h2 class="titulo-display" id="ontologia-titulo">
        23 coleções para organizar memória. Tipos continuam tipos.
      </h2>
      <p class="prosa">
        Coleção é uma organização transversal da memória, não a ontologia do
        portfólio. Produto, Projeto e Iniciativa têm identidade e relações no
        Company Brain; uma memória pode usar as coleções homônimas sem duplicá-los.
        Toque em uma coleção para ver o que ela guarda.
      </p>
    </div>

    <div class="colecoes" data-colecoes>
      {colecoes.map((c, i) => (
        <div
          class:list={["colecao", { destaque: c.destaque }]}
          style={`--ordem:${i}`}
        >
          <button
            type="button"
            class="colecao-topo"
            aria-expanded="false"
            aria-controls={`colecao-${c.id}`}
            data-colecao-botao
          >
            <code>{c.id}</code>
            <span class="colecao-nome">{c.nome}</span>
            <span class="colecao-mais" aria-hidden="true"></span>
          </button>
          <div class="colecao-corpo" id={`colecao-${c.id}`} hidden>
            <p class="prosa">{c.proposito}</p>
            <p class="colecao-exemplo">"{c.exemplo}"</p>
            {c.requisito && <p class="colecao-req">{c.requisito}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ontologia {
    background: var(--fundo-2);
    border-block: 1px solid var(--linha);
  }

  .ontologia-cabeca {
    max-width: 60ch;
    display: grid;
    gap: 1.1rem;
    margin-bottom: 3.2rem;
  }

  .ontologia-cabeca h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }

  .colecoes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    grid-auto-flow: dense;
    gap: 0.8rem;
  }

  .colecao {
    background: var(--fundo-3);
    border: 1px solid var(--linha);
    border-radius: var(--raio-painel);
    overflow: clip;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s var(--ease-suave),
      transform 0.6s var(--ease-suave),
      border-color var(--dur-micro) var(--ease-suave);
    transition-delay: calc(var(--ordem) * 28ms), calc(var(--ordem) * 28ms), 0s;
  }

  [data-visivel] .colecao {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .colecao {
      opacity: 1;
      transform: none;
    }
  }

  .colecao.destaque {
    background:
      linear-gradient(160deg, rgba(52, 211, 153, 0.09), transparent 55%),
      var(--fundo-3);
  }

  .colecao:hover {
    border-color: var(--linha-forte);
  }

  .colecao:has([aria-expanded="true"]) {
    border-color: var(--verde-linha);
    grid-column: span 1;
  }

  .colecao-topo {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: none;
    border: 0;
    color: var(--texto);
    padding: 1rem 1.1rem;
    text-align: left;
    min-height: 56px;
  }

  .colecao-topo code {
    color: var(--verde);
    font-size: 0.85rem;
  }

  .colecao-nome {
    color: var(--texto-2);
    font-size: 0.9rem;
    margin-left: auto;
  }

  .colecao-mais {
    position: relative;
    width: 12px;
    height: 12px;
    flex: none;
  }

  .colecao-mais::before,
  .colecao-mais::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--texto-3);
    transition: transform var(--dur-media) var(--ease-suave);
  }

  .colecao-mais::before {
    width: 12px;
    height: 1.5px;
  }

  .colecao-mais::after {
    width: 1.5px;
    height: 12px;
  }

  [aria-expanded="true"] .colecao-mais::after {
    transform: rotate(90deg);
  }

  .colecao-corpo {
    display: grid;
    gap: 0.7rem;
    padding: 0 1.1rem 1.2rem;
  }

  .colecao-corpo[hidden] {
    display: none;
  }

  .colecao-corpo .prosa {
    font-size: 0.92rem;
  }

  .colecao-exemplo {
    font-family: var(--fonte-mono);
    font-size: 0.82rem;
    color: var(--verde-forte);
    background: var(--fundo-2);
    border: 1px solid var(--linha);
    border-radius: var(--raio-chip);
    padding: 0.55rem 0.75rem;
  }

  .colecao-req {
    font-family: var(--fonte-mono);
    font-size: 0.75rem;
    color: var(--texto-3);
  }

  @media (min-width: 800px) {
    .colecao:has([aria-expanded="true"]) {
      grid-column: span 2;
    }
  }
</style>

<script>
  const grade = document.querySelector<HTMLElement>("[data-colecoes]");
  if (grade) {
    const io = new IntersectionObserver(
      ([entrada]) => {
        if (entrada && entrada.isIntersecting) {
          grade.setAttribute("data-visivel", "");
          io.disconnect();
        }
      },
      { threshold: 0.08 },
    );
    io.observe(grade);

    grade.querySelectorAll<HTMLButtonElement>("[data-colecao-botao]").forEach((botao) => {
      botao.addEventListener("click", () => {
        const aberto = botao.getAttribute("aria-expanded") === "true";
        const corpo = document.getElementById(
          botao.getAttribute("aria-controls") ?? "",
        );
        botao.setAttribute("aria-expanded", String(!aberto));
        if (corpo) corpo.hidden = aberto;
      });
    });
  }
</script>
