---
// A home do OrkMind na estrutura da home do design do dono (a mesma do site do Orkastery), com a
// narrativa própria: hero, hosts, 01 a 08 e a chamada final. Cabeçalho e rodapé vêm do layout
// (Base). O texto vem de src/data/home.ts, na língua da página; o separador entra no máximo um por
// dobra de tela.
import Base from '../layouts/Base.astro';
import Separador from './ds/Separador.astro';
import Hero from './home/Hero.astro';
import Hosts from './home/Hosts.astro';
import Sistema from './home/Sistema.astro';
import Problema from './home/Problema.astro';
import ParaQuem from './home/ParaQuem.astro';
import Integracoes from './home/Integracoes.astro';
import Governanca from './home/Governanca.astro';
import Noite from './home/Noite.astro';
import Caminho from './home/Caminho.astro';
import Prova from './home/Prova.astro';
import ChamadaFinal from './home/ChamadaFinal.astro';
import home from '../data/home';
import {localeFor} from '../data/i18n';
import {plainText} from '../lib/technical-text.mjs';
const locale=localeFor(Astro.url.pathname),t=home[locale];
// O navegador recebe só o que recalcula; o resto da página já sai pronto do build.
const s=t.system;
const runtime={hero:{names:t.hero.names,waitTag:t.hero.waitTag},path:{stages:t.path.stages},
 system:{fns:s.fns,groups:s.groups,active:s.active,refused:s.refused,foot:s.foot,versions:s.versions,collections:s.collections,free:s.free},
 governance:{entries:t.governance.entries,states:t.governance.states,stageWords:t.governance.stageWords},
 integrations:{list:t.integrations.list,whenLabel:t.integrations.whenLabel},night:{events:t.night.events}};
---
<Base titulo={t.title} descricao={plainText(t.description)}>
 <Hero {t}/>
 <Hosts {t}/>
 <Separador/>
 <Sistema {t}/>
 <Separador/>
 <Problema {t}/>
 <Separador/>
 <ParaQuem {t}/>
 <Separador/>
 <Integracoes {t}/>
 <Separador/>
 <Governanca {t}/>
 <Noite {t}/>
 <Caminho {t}/>
 <Separador fundo="superficie"/>
 <Prova {t}/>
 <ChamadaFinal titulo={t.cta.title} texto={t.cta.text} falar={t.cta.talk}/>
 <script type="application/json" id="home-dados" set:html={JSON.stringify(runtime).replace(/</g,'\\u003c')}></script>
</Base>
<script>
 import '../scripts/home.ts';
</script>
