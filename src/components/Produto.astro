---
import {localeFor, localize} from '../data/i18n';
const locale=localeFor(Astro.url.pathname);
const translations={
  "t0": {
    "pt": "Governança acima do backend",
    "en": "Governance above the backend",
    "es": "Gobernanza por encima del backend"
  },
  "t1": {
    "pt": "Proteção de entradas, ACL e ordenação constitucional valem em qualquer backend, sem exceção.",
    "en": "Entry protection, ACL and constitutional ordering apply above every backend.",
    "es": "La protección de entradas, ACL y el orden constitucional se aplican por encima de cada backend."
  },
  "t2": {
    "pt": "Histórico e escrita concorrente",
    "en": "History and concurrent writes",
    "es": "Historial y escritura concurrente"
  },
  "t3": {
    "pt": "Versões append-only e compare-and-swap impedem que uma edição obsoleta vença em silêncio.",
    "en": "Append-only versions and compare-and-swap prevent stale edits from silently overwriting newer work.",
    "es": "Las versiones append-only y compare-and-swap impiden que una edición obsoleta sobrescriba cambios en silencio."
  },
  "t4": {
    "pt": "Criptografia seletiva",
    "en": "Selective encryption",
    "es": "Cifrado selectivo"
  },
  "t5": {
    "pt": "AES-256-GCM em repouso para coleções sensíveis como contatos, arquivos e docs.",
    "en": "AES-256-GCM at rest for sensitive collections such as contacts, files and docs.",
    "es": "AES-256-GCM en reposo para colecciones sensibles como contactos, archivos y docs."
  },
  "t6": {
    "pt": "Anti-injection",
    "en": "Injection detection",
    "es": "Detección de inyección"
  },
  "t7": {
    "pt": "Detecção de conteúdo suspeito: entrada suspeita fica retida e fora da injeção automática.",
    "en": "Suspicious content is held for review and excluded from automatic context injection.",
    "es": "El contenido sospechoso queda retenido para revisión y fuera de la inyección automática de contexto."
  },
  "t8": {
    "pt": "Snapshots globais",
    "en": "Global snapshots",
    "es": "Snapshots globales"
  },
  "t9": {
    "pt": "Commit, diff e restore da árvore de memória inteira, com embeddings preservados.",
    "en": "Commit, diff and restore the memory tree while preserving embeddings.",
    "es": "Commit, diff y restore del árbol de memoria, conservando embeddings."
  },
  "t10": {
    "pt": "Proveniência e receipts",
    "en": "Provenance and receipts",
    "es": "Procedencia y recibos"
  },
  "t11": {
    "pt": "Fonte, revisão e recibos permitem readback, reconciliação e rollback sem fabricar sucesso.",
    "en": "Sources, revisions and receipts support readback, reconciliation and rollback with evidence.",
    "es": "Fuentes, revisiones y recibos permiten readback, reconciliación y rollback con pruebas."
  },
  "t12": {
    "pt": "Um Company Brain governado",
    "en": "A governed Company Brain",
    "es": "Un Company Brain gobernado"
  },
  "t13": {
    "pt": "O core em Python governa identidade, histórico e acesso. Agentes e pessoas\n        chegam ao mesmo conhecimento pela CLI, pelo servidor MCP e pelos hosts que já usam.",
    "en": "The Python core governs identity, history and access. Agents and people reach the same knowledge through the CLI, MCP server and their existing hosts.",
    "es": "El núcleo en Python gobierna identidad, historial y acceso. Agentes y personas llegan al mismo conocimiento mediante el CLI, el servidor MCP y sus hosts habituales."
  },
  "t14": {
    "pt": "A base que governa",
    "en": "The foundation for governance",
    "es": "La base que gobierna"
  },
  "t15": {
    "pt": "Biblioteca Python com PostgreSQL e pgvector. Publicada no PyPI,\n          licenciada MIT.",
    "en": "A Python library with PostgreSQL and pgvector. Published on PyPI under the MIT license.",
    "es": "Una biblioteca Python con PostgreSQL y pgvector. Publicada en PyPI bajo la licencia MIT."
  },
  "t16": {
    "pt": "Confira sua instalação, sem depender de uma contagem publicada.",
    "en": "Inspect your own installation with these commands.",
    "es": "Consulte su propia instalación con estos comandos."
  }
};
const t=(key:keyof typeof translations)=>translations[key][locale];
import Icone from "./Icone.astro";

const capacidadesCore = [
  {
    icone: "shield-check",
    titulo: t("t0"),
    desc: t("t1"),
  },
  {
    icone: "git-branch",
    titulo: t("t2"),
    desc: t("t3"),
  },
  {
    icone: "lock-key",
    titulo: t("t4"),
    desc: t("t5"),
  },
  {
    icone: "shield-check",
    titulo: t("t6"),
    desc: t("t7"),
  },
  {
    icone: "stack",
    titulo: t("t8"),
    desc: t("t9"),
  },
  {
    icone: "hard-drives",
    titulo: t("t10"),
    desc: t("t11"),
  },
];


---

<section class="secao produto" id="produto" aria-labelledby="produto-titulo">
  <div class="container">
    <div class="produto-cabeca">
      <h2 class="titulo-display" id="produto-titulo">{t("t12")}</h2>
      <p class="prosa">
        {t("t13")}
      </p>
    </div>

    <div class="metade" data-revelar>
      <div class="metade-texto">
        <p class="metade-selo"><Icone nome="package" tamanho={16} /> OrkMind 0.4.0</p>
        <h3 class="titulo-display">{t("t14")}</h3>
        <p class="prosa">
          {t("t15")}
        </p>
        <ul class="capacidades" role="list">
          {capacidadesCore.map((c) => (
            <li>
              <Icone nome={c.icone} tamanho={20} classe="capacidade-icone" />
              <div>
                <strong>{c.titulo}</strong>
                <p>{c.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="metade-visual metade-visual-core">
        <p class="prosa">{t("t16")}</p>
        <pre class="core-terminal"><code>pip show orkmind
orkmind store info
orkmind --help</code></pre>
      </div>
    </div>


  </div>
</section>

<style>
  .produto {
    background: var(--fundo);
  }

  .produto-cabeca {
    max-width: 60ch;
    display: grid;
    gap: 1.1rem;
    margin-bottom: 4rem;
  }

  .produto-cabeca h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }

  [data-revelar] {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.75s var(--ease-suave),
      transform 0.75s var(--ease-suave);
  }

  [data-revelar].visivel {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-revelar] {
      opacity: 1;
      transform: none;
    }
  }

  .metade {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  .metade-selo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--fonte-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--verde);
    margin-bottom: 1rem;
  }

  .metade-texto h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    margin-bottom: 0.9rem;
  }

  .capacidades {
    list-style: none;
    padding: 0;
    margin-top: 1.8rem;
    display: grid;
    gap: 1.15rem;
  }

  .capacidades li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .capacidades :global(.capacidade-icone) {
    color: var(--verde);
    margin-top: 0.15rem;
  }

  .capacidades strong {
    display: block;
    font-weight: 600;
    font-size: 0.98rem;
    margin-bottom: 0.15rem;
  }

  .capacidades p {
    color: var(--texto-2);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 46ch;
  }

  .core-terminal {
    background: var(--fundo-3);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-painel);
    padding: 1.5rem 1.6rem;
    overflow-x: auto;
    font-size: 0.84rem;
    line-height: 1.75;
    margin: 0;
  }

  .t-cmd {
    color: var(--texto);
  }

  .t-ok {
    color: var(--verde-forte);
  }

  .t-dim {
    color: var(--texto-3);
  }

  .numeros {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
  }

  .numero {
    border-top: 1px solid var(--linha-forte);
    padding-top: 1.1rem;
  }

  .numero dd {
    font-family: var(--fonte-mono);
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 500;
    color: var(--texto);
    margin: 0;
    order: -1;
  }

  .numero dt {
    color: var(--texto-3);
    font-size: 0.88rem;
    margin-top: 0.3rem;
  }

  @media (min-width: 900px) {
    .metade {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
    }
    .numeros {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  const blocos = document.querySelectorAll<HTMLElement>("#produto [data-revelar]");
  const io = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) {
        if (e.isIntersecting) {
          e.target.classList.add("visivel");
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12 },
  );
  blocos.forEach((b) => io.observe(b));
</script>
