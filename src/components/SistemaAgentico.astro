---
import {localeFor, localize} from '../data/i18n';
const locale=localeFor(Astro.url.pathname);
const translations={
  "t0": {
    "pt": "Orquestrador",
    "en": "Orchestrator",
    "es": "Orquestador"
  },
  "t1": {
    "pt": "Coordena o trabalho com contexto citável do Company Brain e devolve fases, decisões, claims e artefatos à memória empresarial.",
    "en": "Coordinates work using citable Company Brain context and returns phases, decisions, claims and artifacts to shared memory.",
    "es": "Coordina el trabajo con contexto citable del Company Brain y devuelve fases, decisiones, claims y artefactos a la memoria compartida."
  },
  "t2": {
    "pt": "Lê contexto autorizado, devolve evidências",
    "en": "Reads authorized context, returns evidence",
    "es": "Lee contexto autorizado, devuelve pruebas"
  },
  "t3": {
    "pt": "Sub-agentes",
    "en": "Subagents",
    "es": "Subagentes"
  },
  "t4": {
    "pt": "Executam tarefas especializadas. Recebem contexto sob medida pelas tags e devolvem aprendizados ao sistema.",
    "en": "Run specialized tasks, receive context selected by tags and return lessons to the system.",
    "es": "Ejecutan tareas especializadas, reciben contexto seleccionado por etiquetas y devuelven aprendizajes al sistema."
  },
  "t5": {
    "pt": "Leem contexto, gravam aprendizados",
    "en": "Read context, record lessons",
    "es": "Leen contexto, registran aprendizajes"
  },
  "t6": {
    "pt": "Runtimes e sessões",
    "en": "Runtimes and sessions",
    "es": "Runtimes y sesiones"
  },
  "t7": {
    "pt": "Cada sessão nasce e morre, mas o que ela descobriu fica. O estado de sessão é uma coleção tipada da ontologia.",
    "en": "Sessions end, but their findings can remain. Session state is a typed collection in the ontology.",
    "es": "Las sesiones terminan, pero sus hallazgos pueden permanecer. El estado de sesión es una colección tipada de la ontología."
  },
  "t8": {
    "pt": "Gravam estado e histórico de sessão",
    "en": "Record session state and history",
    "es": "Registran estado e historial de sesión"
  },
  "t9": {
    "pt": "Agentes temporários",
    "en": "Temporary agents",
    "es": "Agentes temporales"
  },
  "t10": {
    "pt": "Vivem minutos e desaparecem. Sem memória externa, tudo o que viram sumiria junto com eles.",
    "en": "Short-lived agents can leave findings in external memory for later work.",
    "es": "Los agentes de corta duración pueden dejar hallazgos en la memoria externa para trabajos posteriores."
  },
  "t11": {
    "pt": "Herdam contexto, deixam registro",
    "en": "Inherit context, leave a record",
    "es": "Heredan contexto, dejan un registro"
  },
  "t12": {
    "pt": "Skills",
    "en": "Skills",
    "es": "Skills"
  },
  "t13": {
    "pt": "Capacidades reutilizáveis do sistema. O conhecimento sobre quando e como usá-las mora na coleção de tools.",
    "en": "Reusable capabilities. Knowledge about when and how to use them belongs in the tools collection.",
    "es": "Capacidades reutilizables. El conocimiento sobre cuándo y cómo usarlas reside en la colección de tools."
  },
  "t14": {
    "pt": "Consultam instruções de uso",
    "en": "Retrieve usage instructions",
    "es": "Consultan instrucciones de uso"
  },
  "t15": {
    "pt": "Plugins",
    "en": "Plugins",
    "es": "Plugins"
  },
  "t16": {
    "pt": "Estendem os runtimes por dentro. Os plugins do OrkMind injetam regras mandatórias em todo turno de conversa.",
    "en": "Extend runtimes. Configured OrkMind plugins inject mandatory rules into each conversation turn.",
    "es": "Extienden los runtimes. Los plugins configurados de OrkMind inyectan reglas obligatorias en cada turno de conversación."
  },
  "t17": {
    "pt": "Injetam regras em cada turno",
    "en": "Inject rules each turn",
    "es": "Inyectan reglas en cada turno"
  },
  "t18": {
    "pt": "Integrações",
    "en": "Integrations",
    "es": "Integraciones"
  },
  "t19": {
    "pt": "MCP, provider de memória e API idempotente: caminhos oficiais para qualquer runtime falar com a memória.",
    "en": "MCP, memory provider and idempotent API: official paths for runtimes to access memory.",
    "es": "MCP, provider de memoria y API idempotente: vías oficiales para acceder a la memoria desde los runtimes."
  },
  "t20": {
    "pt": "Transportam leitura e escrita",
    "en": "Transport reads and writes",
    "es": "Transportan lecturas y escrituras"
  },
  "t21": {
    "pt": "Ambiente",
    "en": "Environment",
    "es": "Entorno"
  },
  "t22": {
    "pt": "Repositórios, serviços e infraestrutura. Fatos verificáveis sobre o ambiente viram memória consultável.",
    "en": "Repositories, services and infrastructure. Verifiable environment facts become retrievable memory.",
    "es": "Repositorios, servicios e infraestructura. Los hechos verificables del entorno se convierten en memoria consultable."
  },
  "t23": {
    "pt": "Vira fatos e referências",
    "en": "Provides facts and references",
    "es": "Aporta hechos y referencias"
  },
  "t24": {
    "pt": "Uma fonte de verdade para o sistema inteiro",
    "en": "A shared source of truth for the whole system",
    "es": "Una fuente de verdad compartida para todo el sistema"
  },
  "t25": {
    "pt": "Orquestrador, sub-agentes, sessões, documentos e integrações compartilham\n        identidades estáveis. O conhecimento sobrevive à sessão sem perder fonte ou permissão.",
    "en": "Orchestrators, subagents, sessions, documents and integrations share stable identities. Knowledge outlives a session while retaining provenance and permissions.",
    "es": "Orquestadores, subagentes, sesiones, documentos e integraciones comparten identidades estables. El conocimiento sobrevive a la sesión sin perder procedencia ni permisos."
  }
};
const t=(key:keyof typeof translations)=>translations[key][locale];
import Icone from "./Icone.astro";

interface No {
  id: string;
  rotulo: string;
  icone: string;
  desc: string;
  fluxo: string;
}

const nos: No[] = [
  {
    id: "orquestrador",
    rotulo: t("t0"),
    icone: "tree-structure",
    desc: t("t1"),
    fluxo: t("t2"),
  },
  {
    id: "subagentes",
    rotulo: t("t3"),
    icone: "robot",
    desc: t("t4"),
    fluxo: t("t5"),
  },
  {
    id: "runtimes",
    rotulo: t("t6"),
    icone: "cpu",
    desc: t("t7"),
    fluxo: t("t8"),
  },
  {
    id: "temporarios",
    rotulo: t("t9"),
    icone: "clock-countdown",
    desc: t("t10"),
    fluxo: t("t11"),
  },
  {
    id: "skills",
    rotulo: t("t12"),
    icone: "lightning",
    desc: t("t13"),
    fluxo: t("t14"),
  },
  {
    id: "plugins",
    rotulo: t("t15"),
    icone: "puzzle-piece",
    desc: t("t16"),
    fluxo: t("t17"),
  },
  {
    id: "integracoes",
    rotulo: t("t18"),
    icone: "plugs-connected",
    desc: t("t19"),
    fluxo: t("t20"),
  },
  {
    id: "ambiente",
    rotulo: t("t21"),
    icone: "globe-simple",
    desc: t("t22"),
    fluxo: t("t23"),
  },
];

// posições na elipse (percentuais do contêiner)
const posicoes = nos.map((_, i) => {
  const ang = (i / nos.length) * Math.PI * 2 - Math.PI / 2;
  return {
    x: 50 + Math.cos(ang) * 42,
    y: 50 + Math.sin(ang) * 40,
  };
});
---

<section class="secao sistema" id="sistema" aria-labelledby="sistema-titulo">
  <div class="container">
    <div class="sistema-cabeca">
      <h2 class="titulo-display" id="sistema-titulo">
        {t("t24")}
      </h2>
      <p class="prosa">
        {t("t25")}
      </p>
    </div>

    <div class="sistema-grade">
      <div class="orbita" data-orbita>
        <svg class="orbita-linhas" data-orbita-linhas aria-hidden="true">
          {nos.map((no) => (
            <line data-linha={no.id} x1="0" y1="0" x2="0" y2="0" />
          ))}
        </svg>

        <div class="no-centro" data-no-centro>
          <span class="no-centro-ponto" aria-hidden="true"></span>
          <span class="no-centro-nome">OrkMind</span>
          <span class="no-centro-sub">company brain</span>
        </div>

        {nos.map((no, i) => (
          <button
            class="no"
            type="button"
            data-diagram-box data-no={no.id}
            aria-pressed="false"
            style={`--x:${posicoes[i]!.x};--y:${posicoes[i]!.y}`}
          >
            <Icone nome={no.icone} tamanho={19} />
            <span data-node-label>{no.rotulo}</span>
          </button>
        ))}
      </div>

      <aside class="painel" aria-live="polite">
        {nos.map((no, i) => (
          <div class="painel-item" data-painel={no.id} hidden={i !== 0}>
            <h3>{no.rotulo}</h3>
            <p class="prosa">{no.desc}</p>
            <p class="painel-fluxo">
              <Icone nome="flow-arrow" tamanho={16} />
              {no.fluxo}
            </p>
          </div>
        ))}
      </aside>
    </div>
  </div>
</section>

<style>
  .sistema {
    background: var(--fundo);
  }

  .sistema-cabeca {
    max-width: 60ch;
    display: grid;
    gap: 1.1rem;
    margin-bottom: 3.5rem;
  }

  .sistema-cabeca h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }

  .sistema-grade {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .orbita {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 620px;
    margin-inline: auto;
    width: 100%;
  }

  .orbita-linhas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .orbita-linhas line {
    stroke: var(--linha-forte);
    stroke-width: 1;
    transition: stroke var(--dur-media) var(--ease-suave);
  }

  .orbita-linhas line.ativa {
    stroke: var(--verde);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
    animation: fluir 1.2s linear infinite;
  }

  @keyframes fluir {
    to {
      stroke-dashoffset: -14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbita-linhas line.ativa {
      animation: none;
      stroke-dasharray: none;
    }
  }

  .no-centro {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    background: var(--fundo-3);
    border: 1px solid var(--verde-linha);
    border-radius: var(--raio-pill);
    padding: 1.6rem 2.1rem;
    box-shadow: 0 0 60px rgba(52, 211, 153, 0.12);
  }

  .no-centro-ponto {
    width: 11px;
    height: 11px;
    border-radius: var(--raio-pill);
    background: var(--verde);
    box-shadow: 0 0 0 5px var(--verde-tinta);
    margin-bottom: 0.3rem;
  }

  .no-centro-nome {
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .no-centro-sub {
    font-family: var(--fonte-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-3);
  }

  .no {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    /* A caixa tem a largura do proprio rotulo: posicionada perto da borda, ela nao pode encolher
       para o espaco que sobra ate a borda (era o que fazia o texto vazar). E quanto mais para o
       lado, mais ela se desloca para dentro, para nao sair do desenho. */
    width: max-content;
    max-width: min(44%, 12rem);
    transform: translate(calc(-50% - (var(--x) - 50) * 0.83%), -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--fundo-2);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pill);
    color: var(--texto-2);
    font-size: 0.82rem;
    padding: 0.55rem 0.9rem;
    white-space: normal;
    overflow-wrap: anywhere;
    transition:
      color var(--dur-micro) var(--ease-suave),
      border-color var(--dur-micro) var(--ease-suave),
      background var(--dur-micro) var(--ease-suave);
  }

  .no :global(svg), .no :global(i) { flex-shrink: 0; }
  .no span { min-width: 0; }

  .no:hover,
  .no[aria-pressed="true"] {
    color: var(--texto);
    border-color: var(--verde-linha);
    background: var(--verde-tinta);
  }

  .painel {
    background: var(--fundo-2);
    border: 1px solid var(--linha);
    border-radius: var(--raio-painel);
    padding: 1.8rem;
    min-height: 220px;
  }

  .painel-item {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .painel-item[hidden] {
    display: none;
  }

  .painel-item h3 {
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.3rem;
  }

  .painel-item .prosa {
    font-size: 0.98rem;
  }

  .painel-fluxo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--verde);
    font-family: var(--fonte-mono);
    font-size: 0.82rem;
  }

  @media (min-width: 980px) {
    .sistema-grade {
      grid-template-columns: 1.35fr 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 560px) {
    .no {
      /* comprime a elipse para caber na tela e deixa o rótulo quebrar */
      left: calc(50% + (var(--x) - 50) * 0.9%);
      top: calc(50% + (var(--y) - 50) * 0.94%);
      font-size: 0.7rem;
      padding: 0.4rem 0.6rem;
      gap: 0.3rem;
      white-space: normal;
      max-width: 104px;
      text-align: left;
      line-height: 1.25;
      /* na tela estreita o deslocamento para dentro e menor, para nao encostar no centro */
      transform: translate(calc(-50% - (var(--x) - 50) * 0.3%), -50%);
    }
    .no-centro {
      padding: 0.75rem 1rem;
    }
    .no-centro-nome {
      font-size: 1.05rem;
    }
    .no-centro-sub {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }
    .painel {
      padding: 1.3rem;
    }
  }
</style>

<script>
  const orbita = document.querySelector<HTMLElement>("[data-orbita]");
  if (orbita) {
    const svg = orbita.querySelector<SVGSVGElement>("[data-orbita-linhas]");
    const centro = orbita.querySelector<HTMLElement>("[data-no-centro]");
    const nos = Array.from(orbita.querySelectorAll<HTMLButtonElement>("[data-no]"));
    const paineis = Array.from(
      document.querySelectorAll<HTMLElement>("[data-painel]"),
    );

    const desenharLinhas = () => {
      if (!svg || !centro) return;
      const caixa = orbita.getBoundingClientRect();
      const c = centro.getBoundingClientRect();
      const cx = c.left - caixa.left + c.width / 2;
      const cy = c.top - caixa.top + c.height / 2;
      for (const no of nos) {
        const linha = svg.querySelector<SVGLineElement>(
          `[data-linha="${no.dataset.no}"]`,
        );
        if (!linha) continue;
        const r = no.getBoundingClientRect();
        linha.setAttribute("x1", String(r.left - caixa.left + r.width / 2));
        linha.setAttribute("y1", String(r.top - caixa.top + r.height / 2));
        linha.setAttribute("x2", String(cx));
        linha.setAttribute("y2", String(cy));
      }
    };

    const ativar = (id: string) => {
      for (const no of nos) {
        no.setAttribute("aria-pressed", String(no.dataset.no === id));
      }
      for (const painel of paineis) {
        painel.hidden = painel.dataset.painel !== id;
      }
      svg
        ?.querySelectorAll("line")
        .forEach((l) =>
          l.classList.toggle("ativa", l.getAttribute("data-linha") === id),
        );
    };

    for (const no of nos) {
      no.addEventListener("click", () => ativar(no.dataset.no ?? ""));
      no.addEventListener("pointerenter", () => ativar(no.dataset.no ?? ""));
    }

    const ro = new ResizeObserver(desenharLinhas);
    ro.observe(orbita);
    desenharLinhas();
    ativar("orquestrador");
  }
</script>
