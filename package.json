{
  "name": "orkmind-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website oficial do OrkMind, a camada de memória para sistemas agênticos.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "partitura": "node scripts/partitura.mjs",
    "serve": "serve dist -l tcp://127.0.0.1:8981 --no-clipboard",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:redirecionamentos": "node scripts/check-redirecionamentos.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:previa": "node scripts/check-previa.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "test:docs": "node scripts/docs-schema.test.mjs && node scripts/docs-check.test.mjs",
    "test:redirecionamentos": "node scripts/redirecionamentos.test.mjs",
    "test:previa": "node scripts/previa.test.mjs",
    "test:publicar": "node scripts/publicar.test.mjs",
    "test:code": "node scripts/code-format.test.mjs",
    "check:code": "node scripts/check-code.mjs",
    "prebuild": "npm run docs:check",
    "postbuild": "npm run check:links && npm run check:i18n && npm run check:redirecionamentos && npm run check:public && npm run check:content && npm run test:docs && npm run test:redirecionamentos && npm run test:code && npm run check:code && npm run check:previa && npm run test:previa"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^5.0.0",
    "gsap": "^3.15.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
