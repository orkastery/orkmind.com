  "regras": {
    "acentoUnico": "jade só para espera você e pontos de revisão humana; exceção: borda de luz no CTA de instalação",
    "contrasteTexto": 4.5,
    "estadoNuncaSoCor": true,
    "focoVisivel": "anel-foco em todo elemento interativo"
  },
  "derivacao": {
    "metodo": "O método da família (Manual de Marca, Cor; DESIGN.md, seção 2): primitivos neutros para o chão, um acento só para o que espera você, três estados com preenchimento e variante -tinta para texto no dia, semânticos por tema e a proporção de uso. O OrkMind mantém os neutros, a regência e a brasa da família; troca o latão pelo jade, o verde da marca; e tira o verificado da pátina, que ficaria a 14 graus do jade, para a água, a meio caminho entre o jade e a regência. Cada cor derivada mantém a luminância relativa (e, com ela, todo contraste) e o croma relativo do papel na família, com o matiz próprio.",
    "proporcao": "névoa 58% · papel 18% · tinta 14% · trilho 6% · estados 3% · jade ≤ 1%",
    "marca": "jade é o verde do símbolo do OrkMind sobre fundo escuro (marca/svg/simbolo.svg); a assinatura e o símbolo seguem os arquivos de marca/svg, sem recolorir.",
    "familia": {
      "fonte": "kit Partitura do Claude Design do dono, partitura/partitura.json e partitura/partitura.css",
      "jsonSha256": "e458c1ddda8773bae503c6692a219d052d4749b4da554846a50b0029fbe703af",
      "cssSha256": "3f8e4b79bb4b64a47878612315339fe180a7244cb2d018481f3af05af72943ec"
    },
    "cores": {
      "jade-tinta": {
        "origem": "latao-tinta",
        "matiz": "jade",
        "motivo": "texto de espera você no dia: a mesma luminância do latão-tinta, no matiz do jade"
      },
      "agua": {
        "origem": "patina",
        "matiz": 210,
        "motivo": "verificado: a luminância e o croma relativo da pátina, no matiz 210 (OKLCH), entre o jade (163) e a regência (259)"
      },
      "agua-tinta": {
        "origem": "patina-tinta",
        "matiz": 210,
        "motivo": "texto de verificado no dia"
      }
    }
  }
